@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using WorkingWomenApp.Database.DTOs.ProfileDtos
@using WorkingWomenApp.Database.Models
@using WorkingWomenApp.Database.enums
@model UserProfileDtos
@{

    Layout = "_LayoutDashboard";
}
<div class="row">
    <div class="col-md-10 offset-md-1 mt-5">
        <div class="form-card">
            <div class="brand">

                <h1>Profile</h1>
                <p>We want to know you to customise your experience</p>
            </div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <form id="signUpForm" method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.UserId)
                <div class="row">
                    <div class="form-group col-md-6 d-flex align-items-center">
                       
                        @Html.CheckBoxFor(model => model.IsPregnant, new { htmlAttributes = new { @class = "form-control form-check-input mx-5", placeholder = "Suzan" } })
                        @Html.LabelFor(model => model.IsPregnant, htmlAttributes: new { @class = "control-label col-md-10" })
                        @Html.ValidationMessageFor(model => model.IsPregnant, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.PregnancyWeeks, htmlAttributes: new { @class = "control-label " })
                        @Html.TextBoxFor(model => model.PregnancyWeeks, new { @class = "form-control", @type = "number", @min = 1 })
                        @Html.ValidationMessageFor(model => model.IsPregnant, "", new { @class = "text-danger" })
                    </div>
                   
                </div>
                <div class="row">
                    <div class="form-group col-md-6 d-flex align-items-center">
                        
                        @Html.CheckBoxFor(model => model.IsMother, new { htmlAttributes = new { @class = "form-control form-check-input mx-5", placeholder = "Suzan" } })
                        @Html.LabelFor(model => model.IsMother, htmlAttributes: new { @class = "control-label col-md-10" })
                        @Html.ValidationMessageFor(model => model.IsMother, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.NumberOfChidren, htmlAttributes: new { @class = "control-label " })
                        @Html.TextBoxFor(model => model.NumberOfChidren, new { @class = "form-control ", @type = "number", @min = 1 })

                        @Html.ValidationMessageFor(model => model.NumberOfChidren, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6 d-flex align-items-center">
                       
                        @Html.CheckBoxFor(model => model.IsBreastfeeding, new { htmlAttributes = new { @class = "form-control form-check-input mx-5", placeholder = "Suzan" } })
                        @Html.LabelFor(model => model.IsBreastfeeding, htmlAttributes: new { @class = "control-label col-md-10 " })
                        @Html.ValidationMessageFor(model => model.IsBreastfeeding, "", new { @class = "text-danger" })

                    </div>
                  
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.Profession, htmlAttributes: new { @class = "control-label" })
                        @Html.DropDownListFor(model => model.Profession,
                            new SelectList(Enum.GetValues(typeof(Profession))),
                            "Select a category",
                            new { @class = "form-control" })
                        
                        @Html.ValidationMessageFor(model => model.Profession, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(model => model.ProfessionDescription, htmlAttributes: new { @class = "control-label " })
                        @Html.TextAreaFor(model => model.ProfessionDescription, new { htmlAttributes = new { @class = "form-control form-control-lg", rows = "10", cols = "5" } })
                        @Html.ValidationMessageFor(model => model.IsPregnant, "", new { @class = "text-danger" })

                    </div>
                    <div class="form-group col-md-6">
                       

                    </div>
                </div>
                

                <div class=" col-md-6 col-offset-3 d-grid gap-2  mx-auto mt-2">
                 
                    <button type="submit" class=" btn login-btn">
                        Save
                    </button>
                </div>


              
            </form>



        </div>
    </div>

</div>

@section Scripts
{
    <script type="text/javascript">

        $(document).ready(function() {

            $('.form-check-input').click(

                 function() {

                     $("input[type='radio']").attr('checked',

                     $('.form-check-input').is(':checked'));

                 });

        });
    </script>
}
