@model IEnumerable<WorkingWomenApp.Database.Models.Users.UserProfile>
@{

    Layout = "_LayoutDashboard";
}
<section class="intro">
    <div class="col-md-12">
        <div class="col-md-12">
            <a asp-controller="Profile" asp-action="Details" name="add" id="add" class="btn btn-primary btn-lg">Add Profile</a>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true" style="position: relative; min-height: 700px">
                    <table class="table table-striped mb-0">
                        <thead >
                        <tr>
                            <th scope="col">Full Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col">User Name</th>
                            <th scope="col">Edit Role</th>
                            <th scope="col">Role Mappings</th>
                        </tr>
                        </thead>
                        <tbody>

                        @* @foreach (var item in @Model)
                        {
                            <tr>
                               
                            </tr>
                        } *@

                        </tbody>
                    </table> 
                </div>
            </div>
        </div>
    </div>
    

</section>
