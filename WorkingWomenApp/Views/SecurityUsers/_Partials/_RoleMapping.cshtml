@inject IUnitOfWork _unitOfWork 
@using WorkingWomenApp.BLL.UnitOfWork
@using WorkingWomenApp.Database.Models.Users
@using WorkingWomenApp.Database.Models.Users
@model WorkingWomenApp.Database.DTOs.UserDtos.UserRoleDto
@{
    var count = 0;
    count = count++;
}

<tr class="  margin-bottom-10" collection-name="RoleNames" id="dropdownTemplate">
    <td>@count</td>
    <td>
        @* @Html.DropDownListFor("Item1", new SelectList(Enum.GetValues(typeof(SecurityRole)), "id", "name", "-select-", new { @required = "required" }) *@
        @{
            var roles = _unitOfWork.UserRepository.Set<SecurityRole>().OrderBy(r => r.Name).ToList();
        }
        @if (Model.Roles.Any())
        {
            @Html.DisplayFor(m=>m.Roles.Select(r=>r.RoleName).FirstOrDefault(  ))
        }
        else
        {
            @Html.DropDownList("Item1", new SelectList(roles, "Id", "Name"),
                "Select role", new { })
            @Html.ValidationMessage("Item1")
        }

    </td>
    <td class="text-center"><a href="javascript:void(0)" class="remove-row"><i class="fa fa-trash text-danger"></i></a></td>
</tr>