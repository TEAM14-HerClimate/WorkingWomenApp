@model WorkingWomenApp.Database.DTOs.UserDtos.UserRoleDto;
@{
    Layout = "_LayoutDashboard";
}

<div class="row" style="margin-top:10px">
    <div class="col-sm-12">
        <div class="alert alert-info userRolesDiv"><b>Map the user to Roles.</b></div>
        <div class="row userRolesDiv">
            <div class="col-sm-6" id="">
                <table class="table table-striped table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Role Name</th>
                        <th class="text-center">Options</th>
                    </tr>
                    </thead>
                    <tbody id="userRole">
                    @foreach (var item in @Model.Roles)
                    {
                        <partial name="_Partials/_RoleMapping" model="item"/>
                    }

                    

                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="6" style="text-align:left;">
                            <a class="tm-add-row" href="javascript:void(0)" onclick="addRole()"><i class="fa fa-plus"></i> Add Role</a>
                        </td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>