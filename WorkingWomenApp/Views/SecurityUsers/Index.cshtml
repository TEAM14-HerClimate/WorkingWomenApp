@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<WorkingWomenApp.Database.Models.Users.ApplicationUser>
@{
   
    Layout = "_LayoutDashboard";
}



<ul class="nav nav-tabs mb-3" id="ex-with-icons" role="tablist">
    <li class="nav-item" role="presentation">
        <a data-mdb-tab-init class="nav-link active" id="ex-with-icons-tab-1" asp-controller="SecurityUsers" asp-action="Index" role="tab"
           aria-controls="ex-with-icons-tabs-1" aria-selected="true">Users</a>
    </li>
    <li class="nav-item" role="presentation">
        <a data-mdb-tab-init class="nav-link" id="ex-with-icons-tab-2" asp-controller="SecurityRole" asp-action="Index" role="tab"
           aria-controls="ex-with-icons-tabs-2" aria-selected="false"><i class="fas fa-chart-line fa-fw me-2"></i>Security Roles</a>
    </li>

</ul>
<div class="col-md-12 m-2">
    <a asp-controller="SecurityUsers" asp-action="Details" name="add" id="add" class="btn btn-primary btn-lg">Add Users</a>
</div>
<section class="intro">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true" style="position: relative; min-height: 700px">
                    <table class="table table-striped mb-0">
                        <thead >
                        <tr>
                            <th scope="col">Full Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col">User Name</th>
                            <th scope="col">Egit Role</th>
                            <th scope="col">Spots</th>
                        </tr>
                        </thead>
                        <tbody>
                                        
                        @foreach (var item in @Model)
                        {
                            <tr>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.UserName</td>
                                <td><a href="@Url.Action("Details", "SecurityUsers", new { id = @item.Id })">Edit User</a></td>
                                <td><a href="@Url.Action("Details", "SecurityUsers")">Edit Role Mappings</a></td>
                            </tr>
                        }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    

</section>