@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<WorkingWomenApp.Database.Models.Users.SecurityRole>
@{
    Layout = "_LayoutDashboard";
}

<!-- Tabs navs -->
<ul class="nav nav-tabs mb-3" id="ex-with-icons" role="tablist">
    <li class="nav-item" role="presentation">
        <a data-mdb-tab-init class="nav-link " id="ex-with-icons-tab-1" asp-controller="SecurityUsers" asp-action="Index" role="tab"
           aria-controls="ex-with-icons-tabs-1" aria-selected="true">Users</a>
    </li>
    <li class="nav-item" role="presentation">
        <a data-mdb-tab-init class="nav-link active" id="ex-with-icons-tab-2" asp-controller="SecurityRole" asp-action="Index" role="tab"
           aria-controls="ex-with-icons-tabs-2" aria-selected="false"><i class="fas fa-chart-line fa-fw me-2"></i>Security Roles</a>
    </li>
    
</ul>
<!-- Tabs navs -->

<!-- Tabs content -->
<div class="tab-content" id="ex-with-icons-content">
    <div class="tab-pane fade show active" id="ex-with-icons-tabs-1" role="tabpanel" aria-labelledby="ex-with-icons-tab-1">
        <div class="col-md-12">
            <a asp-controller="SecurityRole" asp-action="EditRole" name="add" id="add" class="btn btn-primary btn-lg">Add Role</a>
        </div>
    </div>
    <div class="tab-pane fade" id="ex-with-icons-tabs-2" role="tabpanel" aria-labelledby="ex-with-icons-tab-2">
        Tab 2 content
    </div>
    <div class="tab-pane fade" id="ex-with-icons-tabs-3" role="tabpanel" aria-labelledby="ex-with-icons-tab-3">
        Tab 3 content
    </div>
</div>
<!-- Tabs content -->



<table class="content-table table ">
    <thead>
    <tr>
        <th>#</th>
        <th>Name</th>
        <th>Actions</th>
    
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>1</td>
            <td>@item.Name</td>
            <td>
                <a asp-action="EditRole" asp-route-id="@item.Id" class="btn btn-primary btn-icon" data-toggle="tooltip" title="Edit"><i class="fa fa-pencil"></i></a>
                @*                 <a href="javascript:void(0)" onclick="showDetails(@item.Id, 'Clients')" class="btn btn-primary btn-icon" data-toggle="tooltip" title="Details"><i class="fa fa-bars"></i></a>
                <a href="javascript:void(0)" onclick="deleteItem(@item.Id)" class="btn btn-danger btn-icon" data-toggle="tooltip" title="Delete"><i class="fa fa-trash"></i></a> *@
            </td>
         
        </tr>
    }
    

    </tbody>
</table>

